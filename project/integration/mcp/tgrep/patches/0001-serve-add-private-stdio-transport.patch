+/// Maximum accepted stdin request line, in bytes. The private client caps
+/// its frames far below this; the limit only bounds a malformed peer.
+const STDIN_MAX_LINE_BYTES: usize = 1024 * 1024;
+
+/// Global search row cap applied before serialization. The per-file
+/// `max_count` never bounds the whole reply; private-protocol integrations
+/// need a hard ceiling on accumulated rows.
+const SEARCH_RESULT_ROW_CAP: usize = 20_000;
+
+/// Serve requests over private stdio pipes.
+///
+/// One request at a time, newline-delimited JSON-RPC, dispatched by the same
+/// `process_request` as TCP. stdin EOF (or a stdout write failure) returns
+/// `Ok(())` so `run` unwinds: the server lock is dropped and the process
+/// exits, stopping the watcher, auto-save and reconcile threads with the
+/// same semantics as the SIGINT handler.
+fn serve_stdio(state: Arc<ServerState>) -> Result<()> {
+    let stdin = std::io::stdin();
+    let mut reader = BufReader::new(stdin.lock());
+    let stdout = std::io::stdout();
+    let mut writer = stdout.lock();
+    let mut line = String::new();
+    loop {
+        line.clear();
+        let read = reader.read_line(&mut line)?;
+        if read == 0 {
+            return Ok(());
+        }
+        if line.len() > STDIN_MAX_LINE_BYTES {
+            let response = json_rpc_error(None, -32600, "request frame too large");
+            writeln!(writer, "{response}")?;
+            writer.flush()?;
+            continue;
+        }
+        let response = process_request(line.trim_end_matches(['\n', '\r']), &state);
+        writeln!(writer, "{response}")?;
+        writer.flush()?;
+    }
+}
