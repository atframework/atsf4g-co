+// Stay below the wrapper's 8 MiB frame limit, including the RPC envelope.
+const STDIO_SEARCH_REPLY_BYTES: usize = 7 * 1024 * 1024;
+
+fn serve_stdio(state: &Arc<ServerState>) -> Result<()> {
+    let mut reader = BufReader::new(std::io::stdin().lock());
+    let mut writer = std::io::stdout().lock();
+    while let Some(line) = read_bounded_line(&mut reader)? {
+        // The embedding client sends ordinary requests without streaming.
+        let response =
+            process_request_streaming(&line, state, &|_| false, STDIO_SEARCH_REPLY_BYTES);
+        writeln!(writer, "{response}")?;
+        writer.flush()?;
+    }
+    Ok(())
+}
