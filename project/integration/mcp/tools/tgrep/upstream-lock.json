{
  "repo_url": "https://github.com/microsoft/tgrep.git",
  "source_commit": "1a846b3abc9bf3a196a426b23e547a91e803aecb",
  "declared_version": "1.2.8",
  "integration_revision": "mcp-stdio-v3",
  "rust_edition": "2024",
  "rust_minimum": "1.88",
  "patches": [
    "patches/0001-serve-add-private-stdio-transport.patch",
    "patches/0002-bound-inherited-ignore-matching-to-served-root.patch"
  ],
  "build_command": ["cargo", "build", "--release", "--locked", "-p", "tgrep-cli"],
  "artifact_relative_path": {
    "windows": "target/release/tgrep.exe",
    "posix": "target/release/tgrep"
  },
  "api_contract": {
    "internal_rpc_methods_wrapped": ["search", "files", "status"],
    "not_exposed": ["reload"],
    "not_ready_error_code": -32001,
    "index_invalid_error_code": -32002,
    "lock_conflict": "serve.lock exclusive lock fails at startup",
    "max_count_semantics": "per-file limit, not a global result cap",
    "transport": "serve --transport stdio (integration patch); newline-delimited JSON-RPC over private pipes; stdin EOF stops the server"
  }
}
