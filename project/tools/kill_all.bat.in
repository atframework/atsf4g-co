@echo off
setlocal EnableExtensions

for %%I in ("%~dp0.") do set "DEPLOY_BASE_DIR=%%~fI"

:parse_args
if "%~1"=="" goto args_done
if /I "%~1"=="-h" goto show_help
if /I "%~1"=="--help" goto show_help
if /I "%~1"=="-d" (
  if "%~2"=="" goto show_help_error
  for %%I in ("%~2") do set "DEPLOY_BASE_DIR=%%~fI"
  shift
  shift
  goto parse_args
)

echo [ERROR] Unknown argument: %~1
goto show_help_error

:args_done
if not exist "%DEPLOY_BASE_DIR%\" (
  echo [ERROR] Deploy base directory does not exist: "%DEPLOY_BASE_DIR%"
  exit /b 1
)

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ErrorActionPreference = 'Stop';" ^
  "$deployBaseDir = [System.IO.Path]::GetFullPath($env:DEPLOY_BASE_DIR);" ^
  "$targetPaths = @(Get-ChildItem -LiteralPath $deployBaseDir -Directory | ForEach-Object {" ^
  "  $binDir = Join-Path $_.FullName 'bin';" ^
  "  if(Test-Path -LiteralPath $binDir) { Get-ChildItem -LiteralPath $binDir -File -Filter '*.exe' | ForEach-Object { [System.IO.Path]::GetFullPath($_.FullName) } }" ^
  "});" ^
  "if($targetPaths.Count -eq 0) { Write-Host ('[INFO] No executable files found under service bin directories in {0}.' -f $deployBaseDir); exit 0 }" ^
  "$targetSet = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase);" ^
  "$targetPaths | ForEach-Object { [void]$targetSet.Add($_) };" ^
  "$processes = @(Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -and $targetSet.Contains([System.IO.Path]::GetFullPath($_.ExecutablePath)) });" ^
  "foreach($process in $processes) {" ^
  "  Write-Host ('[INFO] Killing {0} (pid {1})' -f $process.ExecutablePath, $process.ProcessId);" ^
  "  & taskkill.exe /F /T /PID $process.ProcessId *> $null;" ^
  "}" ^
  "Write-Host '[INFO] Kill all completed.'"
set "KILL_EXIT_CODE=%ERRORLEVEL%"
if not "%KILL_EXIT_CODE%"=="0" (
  echo [ERROR] Failed to enumerate or kill service processes.
)
endlocal & exit /b %KILL_EXIT_CODE%

:show_help
echo usage: %~nx0 [-d deploy_base_dir]
echo Forcefully kills processes whose executable is under a service bin directory.
exit /b 0

:show_help_error
call :show_help
exit /b 1