#!/bin/bash
#
# pack_publish.sh - Pack the deploy base directory into a zstd-compressed tarball.
#
# Default behavior:
#   * Deploy base directory : <script-dir>/publish
#   * Output directory      : <script-dir>
#   * Output files          : <project>-<yyyyMMdd_HHmmss>.package.tar.zst
#                             <project>-<yyyyMMdd_HHmmss>.debug.tar.zst
#                             <project>-<yyyyMMdd_HHmmss>.otel_bin.tar.zst
#   * Before packing, refresh the chart dependencies by running
#     <deploy>/tools/script/update_dependency.sh (helm dependency update per chart).
#   * Before packing, split debug symbols: every shared library (.so) under
#     <deploy>/lib that still carries debug sections has its debug info separated
#     into a sibling ".dbg" file with objcopy (same steps as the
#     project_tool_split_target_debug_sybmol CMake helper) and is stripped, so the
#     archive does not carry debug info.
#   * Excluded from the main package : every directory named "log" (including
#     otelcol/log), every "*.a" / "*.dbg" file, and the otel runtime binaries
#     bin/flatc* plus the whole otelcol directory, which go into the separate
#     otel_bin package instead (relative paths inside both archives match the
#     deploy tree, so either one can be extracted at the deploy root).
#   * All archives omit lifecycle records, process/container IDs, startup errors,
#     private Supervisor state and reset backups. Packing does not clear live state.
#     go-task and helm are not part of the deploy tree (they live in <build>/tools),
#     so they do not appear in the archive and need no exclusion.
#
# Usage:
#   ./pack_publish.sh
#   ./pack_publish.sh -d <deploy_base_dir> -o <output_dir>
#   ./pack_publish.sh --help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DEPLOY_DIR="${SCRIPT_DIR}/publish"
OUTPUT_DIR="${SCRIPT_DIR}"

print_help() {
    cat <<EOF
usage: $(basename "$0") [-d deploy_base_dir] [-o output_dir]
  -d <deploy_base_dir>  Directory to pack. Default: <script-dir>/publish
  -o <output_dir>       Directory for svr-*.tar.zst. Default: <script-dir>
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -d)
            DEPLOY_DIR="$2"
            shift 2
            ;;
        -o)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -h | --help)
            print_help
            exit 0
            ;;
        *)
            echo "[ERROR] Unknown option: $1" >&2
            print_help >&2
            exit 1
            ;;
    esac
done

if [ ! -d "${DEPLOY_DIR}" ]; then
    echo "[ERROR] Deploy base directory does not exist: ${DEPLOY_DIR}" >&2
    exit 1
fi
DEPLOY_DIR="$(cd "${DEPLOY_DIR}" && pwd -P)"
source "${DEPLOY_DIR}/tools/script/common/service-runtime-paths.sh"

# Vendor the chart dependencies before packing so the archive always carries the resolved charts. helm itself lives in
# the build-time tools directory (<build>/tools/helm); the update_dependency script locates it.
UPDATE_DEPENDENCY_SCRIPT="${DEPLOY_DIR}/tools/script/update_dependency.sh"
if [ ! -f "${UPDATE_DEPENDENCY_SCRIPT}" ]; then
    echo "[ERROR] update_dependency script not found: ${UPDATE_DEPENDENCY_SCRIPT}" >&2
    exit 1
fi
echo "[INFO] Updating chart dependencies"
bash "${UPDATE_DEPENDENCY_SCRIPT}"

mkdir -p "${OUTPUT_DIR}"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
OUTPUT_PACKAGE_FILE="${OUTPUT_DIR}/@PROJECT_NAME@-${TIMESTAMP}.package.tar.zst"
OUTPUT_DEBUG_FILE="${OUTPUT_DIR}/@PROJECT_NAME@-${TIMESTAMP}.debug.tar.zst"
OUTPUT_OTEL_BIN_FILE="${OUTPUT_DIR}/@PROJECT_NAME@-${TIMESTAMP}.otel_bin.tar.zst"

# Locate objcopy: GNU objcopy first, then llvm-objcopy (same probing order as the
# project_tool_split_target_debug_sybmol CMake helper).
SPLIT_DEBUG_OBJCOPY="@PROJECT_TOOL_OBJCOPY@"
SPLIT_DEBUG_READELF="@PROJECT_TOOL_READELF@"

# Split debug symbols of every .so under <deploy_base>/lib that still has debug
# sections. Mirrors project_tool_split_target_debug_sybmol: keep debug into
# "<file>.dbg", strip debug/unneeded symbols from the library, then record the
# debug link so debuggers can still find the symbols. Files that already have a
# sibling "<file>.dbg" or carry no debug section are left untouched, so repeated
# packing is a no-op.
split_lib_debug_symbols() {
    local deploy_base="$1"
    local lib_dir="${deploy_base}/lib"
    local so_file=""
    local so_name=""
    local split_count=0

    if [ -z "${SPLIT_DEBUG_OBJCOPY}" ] || [ -z "${SPLIT_DEBUG_READELF}" ]; then
        echo "[WARN] objcopy or readelf not found, skip splitting debug symbols of shared libraries" >&2
        return 0
    fi
    if [ ! -d "${lib_dir}" ]; then
        return 0
    fi

    while IFS= read -r -d '' so_file; do
        # Already split by an earlier build/pack step.
        [ -f "${so_file}.dbg" ] && continue
        # No debug section left (already stripped or a release build).
        if ! "${SPLIT_DEBUG_READELF}" -S "${so_file}" 2>/dev/null | grep -qE '\.debug_'; then
            continue
        fi
        echo "[INFO] Split debug symbols: ${so_file}"
        (
            cd "$(dirname "${so_file}")"
            so_name="$(basename "${so_file}")"
            "${SPLIT_DEBUG_OBJCOPY}" --only-keep-debug "${so_name}" "${so_name}.dbg" || exit 1
            "${SPLIT_DEBUG_OBJCOPY}" --strip-debug --strip-unneeded "${so_name}" || exit 1
            "${SPLIT_DEBUG_OBJCOPY}" --remove-section .gnu_debuglink "${so_name}" 2>/dev/null || true
            "${SPLIT_DEBUG_OBJCOPY}" --add-gnu-debuglink "${so_name}.dbg" "${so_name}" || exit 1
        ) || exit 1
        split_count=$((split_count + 1))
    done < <(find "${lib_dir}" -type f \( -name '*.so' -o -name '*.so.*' \) ! -name '*.dbg' -print0 2>/dev/null)

    if [ "${split_count}" -gt 0 ]; then
        echo "[INFO] Split debug symbols of ${split_count} shared libraries under ${lib_dir}"
    fi
}

split_lib_debug_symbols "${DEPLOY_DIR}"

# A matched directory (named "log") is not descended into, so its whole tree is skipped.
# The otel runtime binaries are packed into the separate otel_bin package, so they are
# kept out of the main one. Members are always generated from "." ("./bin/..."), so the
# "./" prefix anchors the patterns to the deploy root only.
COMMON_EXCLUDES=(
    --exclude='log'
    --exclude='*/log'
    --exclude='log/*'
    --exclude='*/log/*'
    --exclude='*.pid.service'
    --exclude='otelcol.service'
    --exclude='*.pid'
    --exclude='*.pid.old'
    --exclude='*.startup-error'
    --exclude='*.cid'
    --exclude='*.sock'
    --exclude='prepare-package.*.lock'
    --exclude='var/service-manager'
)
RUNTIME_EXCLUDES=(--no-wildcards --anchored)
while IFS= read -r -d '' RUNTIME_PATH; do
    RUNTIME_EXCLUDES+=("--exclude=./${RUNTIME_PATH#"$DEPLOY_DIR"/}")
done < <(service_runtime_paths "$DEPLOY_DIR")
EXCLUDES=(
    --exclude='*.a'
    --exclude='*.dbg'
    --exclude='./bin/flatc*'
    --exclude='./otelcol'
    --exclude='./otelcol/*'
)

echo "[INFO] Packing ${DEPLOY_DIR} -> ${OUTPUT_PACKAGE_FILE}/${OUTPUT_DEBUG_FILE}/${OUTPUT_OTEL_BIN_FILE}"
cd "${DEPLOY_DIR}"
tar "${COMMON_EXCLUDES[@]}" "${EXCLUDES[@]}" "${RUNTIME_EXCLUDES[@]}" -cvf- . | zstd -T0 -B0 -13 --format=zstd -r -f -o "${OUTPUT_PACKAGE_FILE}" -
DBG_FILES=()
while IFS= read -r -d '' DBG_FILE; do DBG_FILES+=("$DBG_FILE"); done < <(find . -name '*.dbg' -print0)
if [[ ${#DBG_FILES[@]} -gt 0 ]]; then
    tar "${COMMON_EXCLUDES[@]}" "${RUNTIME_EXCLUDES[@]}" -cvf- "${DBG_FILES[@]}" | zstd -T0 -B0 -13 --format=zstd -r -f -o "${OUTPUT_DEBUG_FILE}" -
else
    rm -f "${OUTPUT_DEBUG_FILE}"
fi

# otel 运行用的二进制单独成包：bin/flatc* 与整个 otelcol 目录（主包已排除它们）。
# 归档内保留相对路径，解压到部署根目录即可与主包合并。
OTEL_BIN_ENTRIES=()
if [ -d "otelcol" ]; then
    OTEL_BIN_ENTRIES+=("./otelcol")
fi
for OTEL_BIN_FLATC in bin/flatc*; do
    if [ -e "${OTEL_BIN_FLATC}" ]; then
        OTEL_BIN_ENTRIES+=("./${OTEL_BIN_FLATC}")
    fi
done

if [ "${#OTEL_BIN_ENTRIES[@]}" -gt 0 ]; then
    echo "[INFO] Packing ${OTEL_BIN_ENTRIES[*]} -> ${OUTPUT_OTEL_BIN_FILE}"
    tar "${COMMON_EXCLUDES[@]}" --exclude='*.a' --exclude='*.dbg' "${RUNTIME_EXCLUDES[@]}" -cvf- "${OTEL_BIN_ENTRIES[@]}" | zstd -T0 -B0 -13 --format=zstd -r -f -o "${OUTPUT_OTEL_BIN_FILE}" -
else
    echo "[WARN] Skip ${OUTPUT_OTEL_BIN_FILE}: neither otelcol/ nor bin/flatc* found" >&2
    rm -f "${OUTPUT_OTEL_BIN_FILE}"
fi

echo "[INFO] Done.
- ${OUTPUT_PACKAGE_FILE}"

if [[ -e "${OUTPUT_DEBUG_FILE}" ]]; then
    echo "- ${OUTPUT_DEBUG_FILE}"
fi

if [[ -e "${OUTPUT_OTEL_BIN_FILE}" ]]; then
    echo "- ${OUTPUT_OTEL_BIN_FILE}"
fi
