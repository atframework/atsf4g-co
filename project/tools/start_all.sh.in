#!/bin/bash

DEPLOY_BASE_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CONFIG_FILE="start_all.conf"

print_usage() {
  echo "usage: $0 [-d deploy_base_dir] [-c config_file]"
  echo "Each non-empty config line is one batch; entries in the same line start in parallel."
}

trim_line() {
  local line="$1"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

start_otel_collector() {
  local otel_bin_dir="${DEPLOY_BASE_DIR}/otelcol/bin"
  local otel_exe="${otel_bin_dir}/otelcol-contrib"
  if [[ ! -e "$otel_exe" ]]; then
    echo "[INFO] Otel collector not found, skipped."
    return 0
  fi

  if pgrep -x otelcol-contrib >/dev/null 2>&1; then
    echo "[INFO] Otel collector already started, skipped."
    return 0
  fi

  if [[ ! -d "${DEPLOY_BASE_DIR}/otelcol/log" ]]; then
    mkdir -p "${DEPLOY_BASE_DIR}/otelcol/log"
  fi

  echo "[INFO] Starting otel collector: ${otel_exe}"
  (
    cd "$otel_bin_dir" || exit 1
    nohup ./otelcol-contrib --config=../cfg/config.yaml >> ../log/otelcol.log 2>&1 &
  )
  echo "[INFO] Otel collector started."
  return 0
}

run_batch() {
  local batch_index="$1"
  local group_line="$2"
  local scripts=()
  local labels=()
  local pids=()
  local service_name=""
  local start_script=""
  local exit_code=0
  local found_any=0
  local script_index=0
  local failed=0

  for service_name in $group_line; do
    local bin_dir="${DEPLOY_BASE_DIR}/${service_name}/bin"
    if [[ ! -d "$bin_dir" ]]; then
      echo "[ERROR] Missing bin directory: ${bin_dir}" >&2
      return 1
    fi

    found_any=0
    for start_script in "$bin_dir"/start_*.sh; do
      if [[ -f "$start_script" ]]; then
        scripts+=("$start_script")
        found_any=1
      fi
    done

    if [[ $found_any -eq 0 ]]; then
      echo "[ERROR] No start_*.sh found in ${bin_dir}" >&2
      return 1
    fi
  done

  if [[ ${#scripts[@]} -eq 0 ]]; then
    echo "[ERROR] Batch ${batch_index} does not contain any start script." >&2
    return 1
  fi

  echo "[INFO] Batch ${batch_index}: ${group_line}"

  for start_script in "${scripts[@]}"; do
    script_index=$((script_index + 1))
    labels+=("$start_script")

    echo "[INFO] Starting ${start_script}"
    bash "$start_script" &
    pids+=("$!")
  done

  for script_index in "${!pids[@]}"; do
    if wait "${pids[$script_index]}"; then
      echo "[INFO] Completed: ${labels[$script_index]}"
    else
      exit_code=$?
      echo "[ERROR] Failed: ${labels[$script_index]} (exit ${exit_code})" >&2
      failed=1
    fi
  done

  if [[ $failed -ne 0 ]]; then
    return 1
  fi

  return 0
}

while getopts "c:d:h" option; do
  case "$option" in
    c)
      CONFIG_FILE="$OPTARG"
      ;;
    d)
      if [[ ! -d "$OPTARG" ]]; then
        echo "[ERROR] Deploy base directory does not exist: $OPTARG" >&2
        exit 1
      fi
      DEPLOY_BASE_DIR="$(cd "$OPTARG" && pwd -P)"
      ;;
    h)
      print_usage
      exit 0
      ;;
    ?)
      print_usage >&2
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE="${DEPLOY_BASE_DIR}/start_all.conf"
elif [[ "$CONFIG_FILE" != /* ]]; then
  CONFIG_FILE="${DEPLOY_BASE_DIR}/${CONFIG_FILE}"
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "[ERROR] Config file does not exist: ${CONFIG_FILE}" >&2
  exit 1
fi

shopt -s nullglob

start_otel_collector

configured_batch_count=0
while IFS= read -r current_line || [[ -n "$current_line" ]]; do
  current_line="${current_line%%#*}"
  current_line="${current_line//,/ }"
  current_line="$(trim_line "$current_line")"

  if [[ -z "$current_line" ]]; then
    continue
  fi

  configured_batch_count=$((configured_batch_count + 1))
  if ! run_batch "$configured_batch_count" "$current_line"; then
    echo "[ERROR] Batch ${configured_batch_count} failed." >&2
    exit 1
  fi
done < "$CONFIG_FILE"

if [[ $configured_batch_count -eq 0 ]]; then
  echo "[ERROR] No startup batches configured in ${CONFIG_FILE}." >&2
  exit 1
fi

echo "[INFO] All batches completed successfully."