{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy-Update Dependencies",
      "type": "shell",
      "command": "./update_dependency.sh",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish/tools/script"
      },
      "windows": {
        "command": "./update_dependency.bat"
      },
      "group": "none"
    },
    {
      "label": "Deploy-GenerateServiceConfig",
      "type": "shell",
      "command": "generate_config.sh",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish/tools/script"
      },
      "windows": {
        "command": "./generate_config.bat"
      },
      "group": "none"
    },
    {
      "label": "Start Local Etcd",
      "type": "shell",
      "command": "setup-etcd.ps1",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/atframework/libatapp/ci/etcd"
      },
      "windows": {
        "command": "./setup-etcd.ps1"
      },
      "group": "none"
    },
    {
      "label": "Start Local Redis",
      "type": "shell",
      "command": "redis.ps1",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/install/tools/script/redis"
      },
      "windows": {
        "command": "./redis.ps1"
      },
      "group": "none"
    },
    {
      "label": "Start Otel",
      "type": "shell",
      "command": "./otelcol-contrib.exe",
      "args": ["--config=../cfg/config.yaml"],
      "options": {
        "cwd": "${workspaceFolder}/build/publish/otelcol/bin"
      },
      "windows": {
        "command": "./otelcol-contrib.exe"
      },
      "group": "none"
    },
    {
      "label": "Start All",
      "type": "shell",
      "command": "start_all.bat",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish"
      },
      "windows": {
        "command": "./start_all.bat"
      },
      "group": "none"
    },
    {
      "label": "Stop All",
      "type": "shell",
      "command": "stop_all.bat",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish"
      },
      "windows": {
        "command": "./stop_all.bat"
      },
      "group": "none"
    },
    {
      "label": "Kill All",
      "type": "shell",
      "command": "./kill_all.sh",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish"
      },
      "windows": {
        "command": "./kill_all.bat"
      },
      "group": "none"
    },
    {
      "label": "Cleanup Publish Logs",
      "type": "shell",
      "command": "find . -mindepth 2 -maxdepth 2 -type d -name log -exec rm -rf {} +",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/publish"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Get-ChildItem -Directory | ForEach-Object { $logPath = Join-Path -Path $_.FullName -ChildPath 'log'; if (Test-Path -LiteralPath $logPath) { Remove-Item -LiteralPath $logPath -Recurse -Force -ErrorAction SilentlyContinue } }"
        ]
      },
      "group": "none"
    }
  ]
}