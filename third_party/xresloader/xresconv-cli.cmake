# xresconv-cli 自 2.0.0 起改用 Rust 实现，发布各平台预编译可执行程序，不再依赖 Python 运行时。 归档根目录直接存放可执行程序（Windows 为 xresconv-cli.exe，其余平台为
# xresconv-cli）以及 README.md、LICENSE。 按 host 系统类型和架构拼出 Rust target triple，从原始组织 xresloader/xresconv-cli 的 Release 下载。
if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_ARCH "aarch64")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(riscv64|riscv64gc)$")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_ARCH "riscv64gc")
else()
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_ARCH "x86_64")
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS "pc-windows-msvc")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT "zip")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_BIN_NAME "xresconv-cli.exe")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS "apple-darwin")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT "tar.gz")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_BIN_NAME "xresconv-cli")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "FreeBSD")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS "unknown-freebsd")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT "tar.gz")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_BIN_NAME "xresconv-cli")
else()
  # Linux：riscv64 仅提供 gnu 包；x86_64/aarch64 优先使用 musl 静态包以兼容不同 libc 发行版。
  if(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_ARCH STREQUAL "riscv64gc")
    set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS "unknown-linux-gnu")
  else()
    set(PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS "unknown-linux-musl")
  endif()
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT "tar.gz")
  set(PROJECT_THIRD_PARTY_XRESCONV_CLI_BIN_NAME "xresconv-cli")
endif()

set(PROJECT_THIRD_PARTY_XRESCONV_CLI_TARGET_TRIPLE
    "${PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_ARCH}-${PROJECT_THIRD_PARTY_XRESCONV_CLI_HOST_TRIPLE_OS}")
set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_NAME
    "xresconv-cli-${PROJECT_THIRD_PARTY_XRESCONV_CLI_VERSION}-${PROJECT_THIRD_PARTY_XRESCONV_CLI_TARGET_TRIPLE}.${PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT}"
)
set(PROJECT_THIRD_PARTY_XRESCONV_CLI_URL
    "${PROJECT_GITHUB_GIT_HTTP_MIRROR}xresloader/xresconv-cli/releases/download/v${PROJECT_THIRD_PARTY_XRESCONV_CLI_VERSION}/${PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_NAME}"
)

set(PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/xresconv-cli")
set(PROJECT_THIRD_PARTY_XRESLOADER_CLI
    "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/${PROJECT_THIRD_PARTY_XRESCONV_CLI_BIN_NAME}")

# 版本号变化（含从旧的 git clone 布局迁移）时清空缓存目录后重新下载。
if(EXISTS "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
  if(NOT EXISTS "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/xresconv-cli.version")
    file(REMOVE_RECURSE "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
  else()
    file(READ "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/xresconv-cli.version"
         PROJECT_THIRD_PARTY_XRESCONV_CLI_OLD_VERSION)
    string(STRIP "${PROJECT_THIRD_PARTY_XRESCONV_CLI_OLD_VERSION}" PROJECT_THIRD_PARTY_XRESCONV_CLI_OLD_VERSION)
    if(NOT PROJECT_THIRD_PARTY_XRESCONV_CLI_OLD_VERSION STREQUAL PROJECT_THIRD_PARTY_XRESCONV_CLI_VERSION)
      file(REMOVE_RECURSE "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
    endif()
  endif()
endif()

if(NOT EXISTS "${PROJECT_THIRD_PARTY_XRESLOADER_CLI}")
  file(MAKE_DIRECTORY "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
  findconfigurepackagedownloadfile(
    "${PROJECT_THIRD_PARTY_XRESCONV_CLI_URL}"
    "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/${PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_NAME}")
  if(PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_EXT STREQUAL "zip")
    findconfigurepackageunzip(
      "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/${PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_NAME}"
      "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
  else()
    findconfigurepackagetarxv(
      "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/${PROJECT_THIRD_PARTY_XRESCONV_CLI_ARCHIVE_NAME}"
      "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}")
  endif()
endif()

if(NOT EXISTS "${PROJECT_THIRD_PARTY_XRESLOADER_CLI}")
  message(FATAL_ERROR "Download xresconv-cli executable from ${PROJECT_THIRD_PARTY_XRESCONV_CLI_URL} failed.")
endif()

file(WRITE "${PROJECT_THIRD_PARTY_XRESCONV_CLI_ROOT_DIR}/xresconv-cli.version"
     "${PROJECT_THIRD_PARTY_XRESCONV_CLI_VERSION}")
