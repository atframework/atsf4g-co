# =========== third_party gotask (go-task) ==================

set(PROJECT_THIRD_PARTY_GOTASK_VERSION "3.51.1")
set(PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR
    "${PROJECT_THIRD_PARTY_PACKAGE_DIR}/gotask-v${PROJECT_THIRD_PARTY_GOTASK_VERSION}")

if(NOT PROJECT_THIRD_PARTY_GOTASK_RELEASE_MIRROR)
  set(PROJECT_THIRD_PARTY_GOTASK_RELEASE_MIRROR "https://github.com/go-task/task/releases/download")
endif()

if(EXISTS "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/version")
  file(READ "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/version" PROJECT_THIRD_PARTY_GOTASK_EXISTED_VERSION)
else()
  set(PROJECT_THIRD_PARTY_GOTASK_EXISTED_VERSION "")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  set(PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task.exe")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  set(PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task")
else()
  set(PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task")
endif()

set(PROJECT_THIRD_PARTY_GOTASK_NEED_DOWNLOAD FALSE)
foreach(PROJECT_THIRD_PARTY_GOTASK_CHECK_FILE IN LISTS PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES)
  if(NOT EXISTS "${PROJECT_THIRD_PARTY_GOTASK_CHECK_FILE}")
    set(PROJECT_THIRD_PARTY_GOTASK_NEED_DOWNLOAD TRUE)
    break()
  endif()
endforeach()

if(PROJECT_THIRD_PARTY_GOTASK_NEED_DOWNLOAD OR NOT PROJECT_THIRD_PARTY_GOTASK_EXISTED_VERSION STREQUAL
                                               PROJECT_THIRD_PARTY_GOTASK_VERSION)
  file(MAKE_DIRECTORY "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}")
  if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_GOTASK_RELEASE_MIRROR}/v${PROJECT_THIRD_PARTY_GOTASK_VERSION}/task_windows_amd64.zip"
      "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_windows_amd64.zip")
    findconfigurepackageunzip("${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_windows_amd64.zip"
                              "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/")
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_GOTASK_RELEASE_MIRROR}/v${PROJECT_THIRD_PARTY_GOTASK_VERSION}/task_darwin_amd64.tar.gz"
      "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_darwin_amd64.tar.gz")
    findconfigurepackagetarxv("${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_darwin_amd64.tar.gz"
                              "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/")
  else()
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_GOTASK_RELEASE_MIRROR}/v${PROJECT_THIRD_PARTY_GOTASK_VERSION}/task_linux_amd64.tar.gz"
      "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_linux_amd64.tar.gz")
    findconfigurepackagetarxv("${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/task_linux_amd64.tar.gz"
                              "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/")
  endif()

  foreach(PROJECT_THIRD_PARTY_GOTASK_CHECK_FILE IN LISTS PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES)
    if(NOT EXISTS "${PROJECT_THIRD_PARTY_GOTASK_CHECK_FILE}")
      message(FATAL_ERROR "Failed to download gotask into ${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}")
    endif()
  endforeach()

  project_make_executable(${PROJECT_THIRD_PARTY_GOTASK_PREBUILT_FILES})
  file(WRITE "${PROJECT_THIRD_PARTY_GOTASK_PACKAGE_DIR}/version" "${PROJECT_THIRD_PARTY_GOTASK_VERSION}")
endif()
