# =========== third_party helm ==================

set(PROJECT_THIRD_PARTY_HELM_VERSION "3.16.3")
set(PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR
    "${PROJECT_THIRD_PARTY_PACKAGE_DIR}/helm-v${PROJECT_THIRD_PARTY_HELM_VERSION}")

if(NOT PROJECT_THIRD_PARTY_HELM_RELEASE_MIRROR)
  set(PROJECT_THIRD_PARTY_HELM_RELEASE_MIRROR "https://get.helm.sh")
endif()

if(EXISTS "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/version")
  file(READ "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/version" PROJECT_THIRD_PARTY_HELM_EXISTED_VERSION)
else()
  set(PROJECT_THIRD_PARTY_HELM_EXISTED_VERSION "")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  set(PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/windows-amd64/helm.exe")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  set(PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/darwin-amd64/helm")
else()
  set(PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/linux-amd64/helm")
endif()

set(PROJECT_THIRD_PARTY_HELM_NEED_DOWNLOAD FALSE)
foreach(PROJECT_THIRD_PARTY_HELM_CHECK_FILE IN LISTS PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES)
  if(NOT EXISTS "${PROJECT_THIRD_PARTY_HELM_CHECK_FILE}")
    set(PROJECT_THIRD_PARTY_HELM_NEED_DOWNLOAD TRUE)
    break()
  endif()
endforeach()

if(PROJECT_THIRD_PARTY_HELM_NEED_DOWNLOAD OR NOT PROJECT_THIRD_PARTY_HELM_EXISTED_VERSION STREQUAL
                                              PROJECT_THIRD_PARTY_HELM_VERSION)
  file(MAKE_DIRECTORY "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}")
  if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_HELM_RELEASE_MIRROR}/helm-v${PROJECT_THIRD_PARTY_HELM_VERSION}-windows-amd64.zip"
      "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_windows_amd64.zip")
    findconfigurepackageunzip("${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_windows_amd64.zip"
                              "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/")
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_HELM_RELEASE_MIRROR}/helm-v${PROJECT_THIRD_PARTY_HELM_VERSION}-darwin-amd64.tar.gz"
      "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_darwin_amd64.tar.gz")
    findconfigurepackagetarxv("${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_darwin_amd64.tar.gz"
                              "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/")
  else()
    findconfigurepackagedownloadfile(
      "${PROJECT_THIRD_PARTY_HELM_RELEASE_MIRROR}/helm-v${PROJECT_THIRD_PARTY_HELM_VERSION}-linux-amd64.tar.gz"
      "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_linux_amd64.tar.gz")
    findconfigurepackagetarxv("${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/helm_linux_amd64.tar.gz"
                              "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/")
  endif()

  foreach(PROJECT_THIRD_PARTY_HELM_CHECK_FILE IN LISTS PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES)
    if(NOT EXISTS "${PROJECT_THIRD_PARTY_HELM_CHECK_FILE}")
      message(FATAL_ERROR "Failed to download helm into ${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}")
    endif()
  endforeach()

  project_make_executable(${PROJECT_THIRD_PARTY_HELM_PREBUILT_FILES})
  file(WRITE "${PROJECT_THIRD_PARTY_HELM_PACKAGE_DIR}/version" "${PROJECT_THIRD_PARTY_HELM_VERSION}")
endif()
