# clangd 工程配置(仅作用于 clangd,不影响 CMake 真实构建、compile_commands.json、CI 的 clang-tidy)。
#
# 关于 PCH(实测结论,2026-08-10,clangd 22.1.8):
#   A/B 实测 dtmq_client_subscriber.cpp:保留 PCH 3.01~3.04s,剥离 PCH 2.82~2.90s,差距仅 ~5%。
#   剥离 PCH 并不消除卡顿——剥掉后 clangd 仍要从源码重解析 cmake_pch.hxx 及其传递包含的头文件树,
#   成本 ≈ 反序列化 634MB PCH。故此处不再剥离,真正的延迟来自那棵巨大的头文件树。
#
# clangd preamble 缓存:默认 --pch-storage=disk,把每个文件的 preamble 序列化到系统临时目录
#   (preamble-*.pch),跨进程持久,易积累到数十 GB。陈旧缓存由
#   project/integration/vscode/OptimizeVsCodeSettings.cmake 在每次 configure 时清理。
#
# clangd 配置合并语义(见 https://clangd.llvm.org/config.html):
#   - ClangTidy.Add/Remove:跨 fragment 及 .clang-tidy 合并,clangd 配置优先。
#     所以全局基线 + 第三方 If 片段可叠加:src/** 只摘 clang-analyzer-*,third_party 全关。

---
# ---------------------------------------------------------------------------
# clang-tidy baseline (applies to ALL files; merged with .clang-tidy, this wins)
# ---------------------------------------------------------------------------
# Why: clangd runs clang-tidy synchronously on the per-file ASTWorker thread, so heavy checks
# block hover/codeAction/inlayHint/formatting on that file. The single biggest cost is
# clang-analyzer-* (path-sensitive static analysis); clangd's built-in speed table
# (TidyFastChecks.inc) only flags 2 checks as SLOW (misc-const-correctness, +103%;
# altera-id-dependent-backward-branch, +17%), it does NOT cover clang-analyzer-*, which is the
# real latency driver in practice. Removing just that one family keeps the high-value bug checks
# (bugprone-*, cppcoreguidelines-*, performance-*, readability-*, ...) live in the editor.
#
# FastCheckFilter: Loose runs every check that is not *known* to be slow, and auto-skips the two
# measured-slow checks above. It is broader than the default Strict (which also drops checks clangd
# has never timed, including newly-added ones), so we keep more analysis. If editor latency is still
# too high on a heavy TU, switch this to Strict to trim further.
Diagnostics:
  ClangTidy:
    Remove:
      - 'clang-analyzer-*'      # path-sensitive analysis: the dominant per-AST cost in clangd
    FastCheckFilter: Loose      # auto-skip measured-slow checks; keep the rest of .clang-tidy

---
# ---------------------------------------------------------------------------
# Third-party / generated / vendored code: skip clang-tidy entirely (heaviest, lowest value)
# ---------------------------------------------------------------------------
If:
  PathMatch:
    - 'build_jobs_cmake_tools/.*'   # generated code, PCH artifacts
    - 'build/.*'                    # generated code, PCH artifacts
    - 'third_party/.*'              # third-party libraries
    - 'atframework/.*\.h'           # vendored subproject headers
    - 'atframework/.*\.cpp'         # vendored subproject implementation
    - 'atframework/.*\.cc'          # vendored subproject implementation
Diagnostics:
  ClangTidy:
    Remove: ['*']                   # Remove merges with the global fragment -> all checks off here
