<?xml version="1.0" encoding="UTF-8"?>
<!-- <?xml-stylesheet type="text/xsl" href="helper/view.xsl"?> -->
<root>
  <global>
    <java_option desc="java选项-最大内存限制2GB">-Xmx2048m</java_option>
    <java_option desc="java选项-客户端模式">-client</java_option>
    <java_option desc="java选项-默认时区">-Duser.timezone=UTC</java_option>

    <default_scheme name="KeyRow" desc="默认scheme模式参数-Key行号">2</default_scheme>
    <!--<default_scheme name="UeCg-CsvObjectWrapper" desc="Ue-Csv输出的包裹字符">{|}</default_scheme>-->

    <option desc="自定义验证器">--validator-rules validator.yaml</option>
  </global>

  <category desc="类信息">
    <!--
      <tree id="all_cats" name="大分类">
          <tree id="kind" name="角色配置"></tree>
      </tree>
      -->
    <tree id="misc" name="杂项"></tree>
    <tree id="item" name="道具/库存"></tree>
    <tree id="rank" name="排行榜"></tree>
    <tree id="dtmq" name="消息队列"></tree>
    <tree id="level" name="关卡"></tree>
    <tree id="matching" name="匹配"></tree>
  </category>

  <list>
    <item name="常量表" cat="misc" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Const.xlsx|常量|2,2,0,2</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelConstConfig</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/const.bytes</scheme>
      <scheme name="KeyRow">1</scheme>
      <option desc="反转行列">--transpose-data-source</option>
    </item>
    <item name="道具描述总表" cat="item" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Item.xlsx|道具描述总表|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelItemType</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/item_type.bytes</scheme>
    </item>
    <item name="排行榜规则表" cat="rank" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Rank.xlsx|排行榜规则表|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelRankRule</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/rank_rule.bytes</scheme>
    </item>
    <item name="排行榜定义表" cat="rank" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Rank.xlsx|排行榜定义表|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelRankDefine</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/rank_define.bytes</scheme>
    </item>
    <item name="排行榜类型奖励池" cat="rank" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Rank.xlsx|排行榜奖励池|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelRankPeriodRewardPool</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/rank_period_reward_pool.bytes</scheme>
   </item>
   <item name="消息队列频道配置" cat="dtmq" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">DtMq.xlsx|Channel类型配置|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelDtmqChannelType</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/dtmq_channel_type.bytes</scheme>
   </item>
   <item name="Orbit Client 模板" cat="orbit" class="server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">OrbitClient.xlsx|template|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelOrbitClientTemplate</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/orbit_client_template.bytes</scheme>
   </item>

    <item name="关卡表" cat="level" class="client server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Level.xlsx|关卡定义表|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelLevel</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/level.bytes</scheme>
    </item>

    <item name="匹配池" cat="matching" class="server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Matching.xlsx|匹配池|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelMatchingPool</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/matching_pool.bytes</scheme>
    </item>
    <item name="匹配规则组" cat="matching" class="server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Matching.xlsx|匹配规则组|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelMatchingRuleGroup</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/matching_rule_group.bytes</scheme>
    </item>
    <item name="匹配规则" cat="matching" class="server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Matching.xlsx|撮合期匹配规则|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelMatchingRule</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/matching_rule.bytes</scheme>
    </item>
    <item name="匹配结果模板" cat="matching" class="server">
      <scheme name="DataSource" desc="数据源(文件名|表名|数据起始行号,数据起始列号)">Matching.xlsx|匹配结果模板|3,1</scheme>
      <scheme name="ProtoName" desc="协议名">atframework.shared.config.ExcelMatchingResultTemplate</scheme>
      <scheme name="OutputFile" desc="输出文件名">Both/matching_result_template.bytes</scheme>
    </item>
  </list>
</root>
