#!/bin/bash

DEPLOY_BASE_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CONFIG_FILE="start_all.conf"

print_usage() {
  echo "usage: $0 [-d deploy_base_dir] [-c config_file]"
  echo "Each non-empty config line is one batch; batches stop in reverse order and entries in the same line stop in parallel."
}

trim_line() {
  local line="$1"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

run_batch() {
  local batch_index="$1"
  local group_line="$2"
  local scripts=()
  local labels=()
  local pids=()
  local service_name=""
  local stop_script=""
  local exit_code=0
  local found_any=0
  local script_index=0
  local failed=0

  for service_name in $group_line; do
    local bin_dir="${DEPLOY_BASE_DIR}/${service_name}/bin"
    if [[ ! -d "$bin_dir" ]]; then
      echo "[ERROR] Missing bin directory: ${bin_dir}" >&2
      return 1
    fi

    found_any=0
    for stop_script in "$bin_dir"/stop_*.sh; do
      if [[ -f "$stop_script" ]]; then
        scripts+=("$stop_script")
        found_any=1
      fi
    done

    if [[ $found_any -eq 0 ]]; then
      echo "[ERROR] No stop_*.sh found in ${bin_dir}" >&2
      return 1
    fi
  done

  if [[ ${#scripts[@]} -eq 0 ]]; then
    echo "[ERROR] Batch ${batch_index} does not contain any stop script." >&2
    return 1
  fi

  echo "[INFO] Batch ${batch_index}: ${group_line}"

  for stop_script in "${scripts[@]}"; do
    script_index=$((script_index + 1))
    labels+=("$stop_script")

    echo "[INFO] Stopping ${stop_script}"
    bash "$stop_script" &
    pids+=("$!")
  done

  for script_index in "${!pids[@]}"; do
    if wait "${pids[$script_index]}"; then
      echo "[INFO] Completed: ${labels[$script_index]}"
    else
      exit_code=$?
      echo "[ERROR] Failed: ${labels[$script_index]} (exit ${exit_code})" >&2
      failed=1
    fi
  done

  if [[ $failed -ne 0 ]]; then
    return 1
  fi

  return 0
}

while getopts "c:d:h" option; do
  case "$option" in
    c)
      CONFIG_FILE="$OPTARG"
      ;;
    d)
      if [[ ! -d "$OPTARG" ]]; then
        echo "[ERROR] Deploy base directory does not exist: $OPTARG" >&2
        exit 1
      fi
      DEPLOY_BASE_DIR="$(cd "$OPTARG" && pwd -P)"
      ;;
    h)
      print_usage
      exit 0
      ;;
    ?)
      print_usage >&2
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE="${DEPLOY_BASE_DIR}/start_all.conf"
elif [[ "$CONFIG_FILE" != /* ]]; then
  CONFIG_FILE="${DEPLOY_BASE_DIR}/${CONFIG_FILE}"
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "[ERROR] Config file does not exist: ${CONFIG_FILE}" >&2
  exit 1
fi

shopt -s nullglob

configured_batch_count=0
batch_lines=()
while IFS= read -r current_line || [[ -n "$current_line" ]]; do
  current_line="${current_line%%#*}"
  current_line="${current_line//,/ }"
  current_line="$(trim_line "$current_line")"

  if [[ -z "$current_line" ]]; then
    continue
  fi

  configured_batch_count=$((configured_batch_count + 1))
  batch_lines+=("$current_line")
done < "$CONFIG_FILE"

if [[ $configured_batch_count -eq 0 ]]; then
  echo "[ERROR] No stop batches configured in ${CONFIG_FILE}." >&2
  exit 1
fi

for ((batch_index=configured_batch_count; batch_index>=1; --batch_index)); do
  if ! run_batch "$batch_index" "${batch_lines[$((batch_index - 1))]}"; then
    echo "[ERROR] Batch ${batch_index} failed." >&2
    exit 1
  fi
done

echo "[INFO] All batches completed successfully."