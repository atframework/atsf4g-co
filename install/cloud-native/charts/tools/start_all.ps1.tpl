<#
.SYNOPSIS
    Start all service batches generated from the tools chart.
.DESCRIPTION
    Generated by `atdtool template --mode deploy_script`. Do not edit manually.
    Batches run in group order, entries in the same batch start in parallel,
    and the script fails fast when any entry fails.
    The OpenTelemetry collector (otelcol/bin) is started first when present.
.PARAMETER Help
    Print help message and exit.
.PARAMETER DeployBaseDirectory
    Deploy base directory. Defaults to the directory containing this script.
.EXAMPLE
    .\start_all.ps1
    pwsh -File .\start_all.ps1 -d <deploy_base_dir>
    Get-Help .\start_all.ps1 -detailed
    Get-Help .\start_all.ps1 -full
#>

[CmdletBinding()]
param (
    [Parameter(ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
    [switch]$Help,

    [Parameter(ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
    [Alias('d')]
    [string]$DeployBaseDirectory = (Split-Path -Parent $PSCommandPath)
)

$ErrorActionPreference = 'Stop'
$PSDefaultParameterValues['*:Encoding'] = 'utf8'

function Show-Help {
    Write-Host ('usage: {0} [-d deploy_base_dir]' -f (Split-Path -Leaf $PSCommandPath))
    Write-Host 'Batches run in group order; entries in the same batch start in parallel.'
}

function Get-ScriptHostExecutable {
    $PwshCommand = Get-Command 'pwsh' -ErrorAction SilentlyContinue
    if ($null -ne $PwshCommand) {
        return $PwshCommand.Source
    }
    return (Get-Command 'powershell' -ErrorAction Stop).Source
}

function Invoke-ScriptsInParallel {
    param (
        [string[]]$ScriptPaths,
        [string]$ActionLabel
    )

    if ($ScriptPaths.Count -eq 0) {
        Write-Host '[ERROR] Batch does not contain any script.'
        return $false
    }

    $ScriptHostExecutable = Get-ScriptHostExecutable
    $Jobs = @()
    foreach ($ScriptPath in $ScriptPaths) {
        Write-Host ('[INFO] {0} {1}' -f $ActionLabel, $ScriptPath)
        $Process = Start-Process -FilePath $ScriptHostExecutable `
            -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $ScriptPath) `
            -WorkingDirectory (Split-Path -Parent $ScriptPath) -PassThru -NoNewWindow
        if ($null -eq $Process) {
            Write-Host ('[ERROR] Failed to start {0}.' -f $ScriptPath)
            return $false
        }
        $Jobs += [pscustomobject]@{ Script = $ScriptPath; Process = $Process }
    }

    $Failed = $false
    foreach ($Job in $Jobs) {
        $Job.Process.WaitForExit()
        if ($Job.Process.ExitCode -ne 0) {
            Write-Host ('[ERROR] Failed: {0} (exit {1})' -f $Job.Script, $Job.Process.ExitCode)
            $Failed = $true
        }
        else {
            Write-Host ('[INFO] Completed: {0}' -f $Job.Script)
        }
    }
    return -not $Failed
}

function Start-OtelCollector {
    param ([string]$DeployBaseDirectory)

    $OtelBinDir = Join-Path $DeployBaseDirectory 'otelcol\bin'
    $OtelExecutable = Join-Path $OtelBinDir 'otelcol-contrib.exe'
    if (-not (Test-Path -LiteralPath $OtelExecutable -PathType Leaf)) {
        Write-Host '[INFO] Otel collector not found, skipped.'
        return
    }

    if ($null -ne (Get-Process -Name 'otelcol-contrib' -ErrorAction SilentlyContinue)) {
        Write-Host '[INFO] Otel collector already started, skipped.'
        return
    }

    $OtelLogDir = Join-Path $DeployBaseDirectory 'otelcol\log'
    if (-not (Test-Path -LiteralPath $OtelLogDir -PathType Container)) {
        New-Item -ItemType Directory -Path $OtelLogDir -Force | Out-Null
    }

    Write-Host ('[INFO] Starting otel collector: {0}' -f $OtelExecutable)
    $Process = Start-Process -FilePath $OtelExecutable -ArgumentList @('--config=..\cfg\config.yaml') `
        -WorkingDirectory $OtelBinDir -WindowStyle Hidden `
        -RedirectStandardOutput (Join-Path $OtelLogDir 'otelcol.log') `
        -RedirectStandardError (Join-Path $OtelLogDir 'otelcol.err.log') -PassThru
    if ($null -eq $Process) {
        Write-Host '[WARNING] Failed to start otel collector.'
    }
    else {
        Write-Host ('[INFO] Otel collector started (pid {0}).' -f $Process.Id)
    }
}

function Invoke-ServiceBatch {
    param (
        [string]$ActionLabel,
        [int]$Group,
        [string[]]$Entries
    )

    if ($Entries.Count -eq 0) {
        Write-Host ('[INFO] Batch {0} does not contain any entry, skipped.' -f $Group)
        return
    }

    $ScriptPaths = @()
    foreach ($Entry in $Entries) {
        $Parts = @($Entry -split ' ', 2)
        $ServiceName = $Parts[0]
        $BusAddr = $Parts[1]
        $ScriptPath = Join-Path (Join-Path $DeployBaseDirectory $ServiceName) ('bin\start_{0}.ps1' -f $BusAddr)
        if (-not (Test-Path -LiteralPath $ScriptPath -PathType Leaf)) {
            Write-Host ('[ERROR] Missing start script: "{0}"' -f $ScriptPath)
            exit 1
        }
        $ScriptPaths += $ScriptPath
    }

    Write-Host ('[INFO] Batch {0}: {1}' -f $Group, ($Entries -join ' '))
    if (-not (Invoke-ScriptsInParallel -ScriptPaths $ScriptPaths -ActionLabel $ActionLabel)) {
        exit 1
    }
}

if ($Help) {
    Show-Help
    exit 0
}

if (-not (Test-Path -LiteralPath $DeployBaseDirectory -PathType Container)) {
    Write-Host ('[ERROR] Deploy base directory does not exist: "{0}"' -f $DeployBaseDirectory)
    exit 1
}
$DeployBaseDirectory = (Resolve-Path -LiteralPath $DeployBaseDirectory).ProviderPath

Start-OtelCollector -DeployBaseDirectory $DeployBaseDirectory

{{ range $group := .Values.proc_groups }}{{ $Entries := list }}{{ range $proc := $group.procs }}{{ range $instance := $proc.instances }}{{ $Entries = append $Entries (printf "%s %s" $proc.name $instance.bus_addr) }}{{ end }}{{ end }}
Invoke-ServiceBatch -ActionLabel 'Starting' -Group {{ $group.group }} -Entries (ConvertFrom-Json '{{ $Entries | toJson }}')
{{ end }}

Write-Host '[INFO] All batches completed successfully.'
exit 0